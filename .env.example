# Домен и TLS
DOMAIN=example.ru
CLINIC_TIMEZONE=Europe/Moscow

# PostgreSQL
POSTGRES_DB=antenatal
POSTGRES_USER=antenatal
POSTGRES_PASSWORD=change-me-strong-password
BACKUP_PASSPHRASE=change-me-backup-passphrase

# Первый администратор (создаётся при старте, если ещё нет)
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=change-me-at-least-12-chars

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-random-secret
PUBLIC_BASE_URL=https://example.ru

# MAX
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=change-me-random-secret
MAX_API_BASE_URL=https://platform-api2.max.ru

# Локальная разработка: демо-врач и демо-пациентка
DEV_MODE=false
